generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Person {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  joiningDate  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdByImportId String?
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  importRuns   ImportRun[]
  cleanExportFiles CleanExportFile[]
}

model ImportRun {
  id          String   @id
  fileName    String
  status      String
  totalRows   Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  rejected    Int      @default(0)
  warnings    Int      @default(0)
  createdAt   DateTime @default(now())
  confirmedAt DateTime?
  previewJson String
  previewExpiresAt DateTime
  rows        ImportRowResult[]
  events      ImportEvent[]
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model ImportRowResult {
  id          Int    @id @default(autoincrement())
  importRunId String
  importRun   ImportRun @relation(fields: [importRunId], references: [id])
  rowNumber   Int
  name        String
  email       String
  phone       String
  joiningDate String
  status      String
  reason      String?
  warnings    String?
  changesJson String?
  personId    String?
  previousJson String?
}

model UndoLog {
  importRunId String @id
  undoneAt    DateTime @default(now())
}

model CleanExportFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  rowsJson  String
  rowCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportEvent {
  id          Int      @id @default(autoincrement())
  importRunId String
  importRun   ImportRun @relation(fields: [importRunId], references: [id])
  type        String
  message     String
  createdAt   DateTime @default(now())
}
